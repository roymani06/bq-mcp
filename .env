# ==============================================================================
# GCP BigQuery MCP Server - Environment Configuration Overrides
# ==============================================================================

# Google Cloud Service Account Authentication
SERVICE_ACCOUNT_KEY_PATH=service-account.json
# Optional: explicitly specify project ID if different from service account file
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_LOCATION=us-east4

# Server & HTTP Transport
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENDPOINT_PATH=/mcp

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Custom configuration file path (optional)
# CONFIG_PATH=config/config.yaml
